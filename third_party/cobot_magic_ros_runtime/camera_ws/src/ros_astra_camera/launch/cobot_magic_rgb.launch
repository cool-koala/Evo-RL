<launch>
    <arg name="camera_f_serial" default="AU1SB3300XB"/>
    <arg name="camera_l_serial" default="AU1SB3300YB"/>
    <arg name="camera_r_serial" default="AU1SB33005A"/>
    <arg name="device_num" default="3"/>
    <arg name="width" default="640"/>
    <arg name="height" default="480"/>
    <arg name="fps" default="30"/>

    <include file="$(find astra_camera)/launch/dabai.launch">
        <arg name="camera_name" value="camera_f"/>
        <arg name="serial_number" value="$(arg camera_f_serial)"/>
        <arg name="device_num" value="$(arg device_num)"/>
        <arg name="color_width" value="$(arg width)"/>
        <arg name="color_height" value="$(arg height)"/>
        <arg name="color_fps" value="$(arg fps)"/>
        <arg name="enable_depth" value="false"/>
        <arg name="enable_ir" value="false"/>
        <arg name="enable_point_cloud" value="false"/>
        <arg name="enable_point_cloud_xyzrgb" value="false"/>
    </include>

    <include file="$(find astra_camera)/launch/dabai.launch">
        <arg name="camera_name" value="camera_l"/>
        <arg name="serial_number" value="$(arg camera_l_serial)"/>
        <arg name="device_num" value="$(arg device_num)"/>
        <arg name="color_width" value="$(arg width)"/>
        <arg name="color_height" value="$(arg height)"/>
        <arg name="color_fps" value="$(arg fps)"/>
        <arg name="enable_depth" value="false"/>
        <arg name="enable_ir" value="false"/>
        <arg name="enable_point_cloud" value="false"/>
        <arg name="enable_point_cloud_xyzrgb" value="false"/>
    </include>

    <include file="$(find astra_camera)/launch/dabai.launch">
        <arg name="camera_name" value="camera_r"/>
        <arg name="serial_number" value="$(arg camera_r_serial)"/>
        <arg name="device_num" value="$(arg device_num)"/>
        <arg name="color_width" value="$(arg width)"/>
        <arg name="color_height" value="$(arg height)"/>
        <arg name="color_fps" value="$(arg fps)"/>
        <arg name="enable_depth" value="false"/>
        <arg name="enable_ir" value="false"/>
        <arg name="enable_point_cloud" value="false"/>
        <arg name="enable_point_cloud_xyzrgb" value="false"/>
    </include>
</launch>
