<launch>

    <!-- <param name="/use_sim_time" value="true" /> -->
    <arg name="reconfigure" default="false" />
    <arg name="control_mode" default="0" doc="Control mode: 0=manual/gravity, 2=ROS joint command" />
    <arg name="joint_topic" default="/cobot_magic/leader/joint_right" />
    <arg name="command_topic" default="/cobot_magic/leader/command_joint_right" />
    <arg name="manual_control_topic" default="/cobot_magic/leader/manual_control_right" />
    <arg name="end_topic" default="/cobot_magic/leader/end_right" />

    <node if="$(arg reconfigure)" name="configure" pkg="rqt_reconfigure" type="rqt_reconfigure"> </node>
    <node name="arm_node" pkg="arm_control" type="arm_node" respawn="true" output="screen">
        <param name="control_mode" value="$(arg control_mode)" />
        <param name="joint_topic" value="$(arg joint_topic)" />
        <param name="command_topic" value="$(arg command_topic)" />
        <param name="manual_control_topic" value="$(arg manual_control_topic)" />
        <param name="end_topic" value="$(arg end_topic)" />
    </node>

</launch>
